# ---- Required for the admin area (login password). Admin stays locked if this is empty. ----
ADMIN_PASSWORD=change-me-to-something-long
# Optional extra secret mixed into the admin session signature
SESSION_SECRET=

# ---- AI (optional). Without a key the demo still works in "extractive" mode. ----
# Which provider answers: groq | gemini | none.
# Leave empty to auto-pick: groq if GROQ_API_KEY is set, else gemini if GEMINI_API_KEY is set, else none.
LLM_PROVIDER=

# Groq (default): fast, free tier, OpenAI-compatible. Retrieval is keyword-based (Groq has no embeddings).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b   # used automatically when the primary model's daily cap is hit (empty = off)
# Alternatives on Groq: openai/gpt-oss-20b (faster, cheaper), qwen/qwen3.8-27b. Check GET https://api.groq.com/openai/v1/models
# Only change to point at a proxy or a test server
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (optional): same answers plus semantic embeddings for retrieval.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Branding shown in the chat and used in the AI prompt ----
BUSINESS_NAME=Northwind Supply Co.
BUSINESS_CONTACT=support@northwindsupply.example
# Public URL used in embed snippets (auto-detected when empty)
PUBLIC_URL=

# ---- Storage ----
# Local dev: leave empty -> SQLite file in ./data (or set DATA_DIR).
# Production (Vercel): create a free Turso database and set both:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATA_DIR=

# ---- Limits ----
RATE_LIMIT_PER_MIN=20
# Set to 0 to disable auto-seeding the sample docs on an empty database
AUTO_SEED=1

# ---- Optional: append each lead to a Google Sheet (share the sheet with the service-account email) ----
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
